# Banco local em arquivo (sem custo)
DATABASE_URL="file:./dev.db"

# OpenAI - gpt-4o-mini mantem custo baixo por conversa.
# Troque OPENAI_MODEL se sua conta nao tiver acesso a esse modelo ou quiser mais qualidade.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Conexao WhatsApp direta (Baileys) - pasta onde fica a sessao de cada clinica.
# Em producao isso PRECISA estar num volume persistente, senao perde a conexao
# a cada deploy e precisa escanear o QR de novo.
WHATSAPP_AUTH_DIR=./whatsapp-auth

# Opcional - roteia SO o trafego do WhatsApp por um proxy (a OpenAI continua
# indo direto). Use quando a VPS estiver sendo recusada pelo WhatsApp (erro
# 428 "Connection Terminated" mesmo com sessao nova) - aponte pra um proxy
# residencial/movel. Aceita http://, https:// e socks5://, com login opcional:
#   WHATSAPP_PROXY_URL=socks5://usuario:senha@host:1080
# Sem essa variavel, conecta direto (comportamento padrao).
WHATSAPP_PROXY_URL=

# Porta do servidor HTTP do painel administrativo
# 3010 pra nao colidir com outros projetos seus (3000/3001 ja estao em uso)
PORT=3010

# Chave usada pra assinar o cookie de sessao de todas as contas do painel
# (admin e client). OBRIGATORIA - o servidor recusa subir sem ela. Gere um
# valor aleatorio forte, por exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
