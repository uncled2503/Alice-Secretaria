# Banco local em arquivo (sem custo)
DATABASE_URL="file:./dev.db"

# OpenAI - gpt-4o-mini mantem custo baixo por conversa.
# Troque OPENAI_MODEL se sua conta nao tiver acesso a esse modelo ou quiser mais qualidade.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Destino do backup consistente do SQLite.
BACKUP_DIR=./backups

# URL publica HTTPS da Alice. Usada para montar o webhook configurado em cada
# instancia UAZAPI. Nao inclua / no final.
PUBLIC_BASE_URL=https://alice.seudominio.com.br

# Segredo usado para assinar a URL de webhook de cada clinica. Gere um valor
# aleatorio forte e diferente do SESSION_SECRET (minimo 32 caracteres).
UAZAPI_WEBHOOK_SECRET=

# A URL e o token de cada instancia sao cadastrados no painel por um admin,
# em Personalizar Alice > Clinicas (ou Canais para a clinica selecionada).
# Tokens ficam no SQLite e nunca voltam ao browser.

# Porta do servidor HTTP do painel e dos webhooks UAZAPI
# 3010 pra nao colidir com outros projetos seus (3000/3001 ja estao em uso)
PORT=3010

# Chave usada pra assinar o cookie de sessao de todas as contas do painel
# (admin e client). OBRIGATORIA - o servidor recusa subir sem ela. Gere um
# valor aleatorio forte, por exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Protege a rota de criacao do primeiro administrador. Use outro valor
# aleatorio, envie-o no header X-Bootstrap-Token e remova-o depois do cadastro.
ADMIN_BOOTSTRAP_TOKEN=
