# Banco local em arquivo (sem custo)
DATABASE_URL="file:./dev.db"

# OpenAI - gpt-4o-mini mantem custo baixo por conversa.
# Troque OPENAI_MODEL se sua conta nao tiver acesso a esse modelo ou quiser mais qualidade.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# UazAPI (self-hosted ou cloud) - UAZAPI_TOKEN e o token da INSTANCIA
# (obtido ao criar a instancia), nao o admintoken usado so pra gerenciar instancias.
UAZAPI_BASE_URL=https://SEU-SERVIDOR.uazapi.com
UAZAPI_TOKEN=

# Porta do servidor HTTP que recebe os webhooks
# 3010 pra nao colidir com outros projetos seus (3000/3001 ja estao em uso)
PORT=3010

# Login do painel administrativo (/admin) - troque para algo forte antes de expor na internet
ADMIN_USER=admin
ADMIN_PASSWORD=
