// SQLite: banco em arquivo, sem custo de hospedagem de DB.
// Quando o volume crescer, troca "provider" para "postgresql" e o schema
// continua funcionando quase sem alteracoes.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Clinic {
  id            String    @id @default(cuid())
  name          String
  whatsappPhone String    @unique // numero do WhatsApp conectado (formato 55DDDNUMERO); atualizado sozinho ao parear
  timezone      String    @default("America/Sao_Paulo")
  workStartHour Int       @default(9)
  workEndHour   Int       @default(19)
  lunchStartHour Int?     // intervalo (ex.: almoço) dentro do expediente - null = sem pausa, atende direto
  lunchEndHour   Int?
  // Minutos (0-59) complementando as horas acima, pra expediente que nao cai
  // em hora cheia (ex.: 08:30, intervalo ate 11:45). Aditivo: default 0 =
  // comportamento identico a antes pra quem nunca configurou isso.
  workStartMinute  Int @default(0)
  workEndMinute    Int @default(0)
  lunchStartMinute Int @default(0)
  lunchEndMinute   Int @default(0)
  workDays      String    @default("1,2,3,4,5,6") // dias da semana com expediente (0=domingo..6=sabado), separados por virgula
  holidayOpen   String    @default("") // nomes (separados por virgula) dos feriados nacionais em que a clinica ABRE; os demais ela fecha (aba Feriados do painel)
  closedOnHolidays Boolean @default(true) // fecha automaticamente nos feriados nacionais (data fixa + Sexta-feira Santa) - Carnaval/Corpus Christi ficam de fora (ponto facultativo, nao feriado por lei); ver src/scheduling/holidays.ts
  active        Boolean   @default(true) // false = bloqueada temporariamente (ex: inadimplencia) - contas client dessa clinica nao conseguem logar nem usar a API
  notifyPhone   String?   // numero (com DDI/DDD) que recebe avisos de agendamento/cancelamento/handoff via WhatsApp
  notifyEvents  String    @default("") // quais avisos mandar pro notifyPhone, separados por virgula: new_appointment,reschedule,cancel,human_handoff

  // Credenciais da instancia UAZAPI desta clinica. O token nunca e enviado
  // ao navegador; fica restrito ao backend e aos backups protegidos do banco.
  uazapiBaseUrl String?
  uazapiToken   String?   @unique
  webhookVersion Int      @default(0) // sobe a cada rotacao da assinatura do webhook (0 = assinatura original, sem versao)

  // Como a Alice se apresenta no atendimento ao paciente. Ela NUNCA se
  // identifica como IA/assistente virtual - so como:
  //   team                   -> "da equipe da {clinica}"
  //   clinic_secretary       -> "secretaria da {clinica}"
  //   professional_secretary -> "secretaria de {assistantPersonaName}"
  assistantPersona     String  @default("team")
  assistantPersonaName String? // nome do profissional quando assistantPersona = professional_secretary (ex: "Dra. Camila")

  // Ajustes da Alice (aba "Personalizar Alice" -> "Ajustes")
  assistantName        String  @default("Alice") // nome pelo qual ela se apresenta
  activityArea         String? // area de atuacao da clinica, em texto livre (ajuda a Alice a entender o tipo de cuidado)
  handoffPhrase        String? // frase que ela escreve antes de passar pra equipe (vazio = frase padrao)
  splitLongMessages    Boolean @default(true) // quebra respostas longas em varias bolhas
  splitMaxMessages     Int     @default(4)
  splitThresholdChars  Int     @default(450) // a partir de quantos caracteres ja e "resposta longa"
  replyDelaySeconds    Int     @default(0) // espera N seg pra agrupar mensagens quebradas do cliente (0 = responde na hora)
  hoursByDay           String? // expediente por dia da semana pra AUTOMACOES (JSON {"6":[8,15]}: sabado 8h-15h); vazio = usa workStart/workEnd. Nao afeta a agenda
  softSell             Boolean @default(false) // true = a Alice menciona a avaliacao no maximo UMA vez e nao insiste (nem em resposta de preco); conversa e tira duvidas antes de agendar
  saveContactsToPhone  Boolean @default(false) // true = salva cada paciente com nome na agenda de contatos do celular da clinica (src/crm/phoneContacts.ts)
  handoffOnPrice       Boolean @default(false) // true = assim que o paciente pergunta valor/preco, a conversa vai pra equipe (a Alice nao responde)
  leadReactivationDay  Int?    // dia do mes (1-28) em que sai a campanha "Leads do mes" (leads do mes que nao agendaram/compraram); null = desligada (src/crm/leadReactivation.ts)
  leadReactivationMessage String? // texto da campanha mensal; aceita {primeiro_nome} e {procedimento}
  evalNearestFirst     Boolean @default(false) // true = avaliacao: a Alice oferece SEMPRE os horarios livres mais proximos (hoje/amanha antes de outros dias); ver nearestSlots em scheduling/slots.ts
  npsEvaluationMessage String? // mensagem da pesquisa de satisfacao quando o atendimento concluido e uma AVALIACAO (procedimento com "avalia" no nome); null = usa npsMessage
  aiModel              String? // modelo da OpenAI so desta clinica (admin); null = padrao do servidor (OPENAI_MODEL). Ver chatModelFor em ai/alice.ts
  humanReturnMinutes   Int     @default(0) // > 0 = se a equipe assumiu a conversa, a pessoa escreveu e ninguem respondeu em N min, a Alice volta a atender (src/crm/humanReturn.ts); 0 = desligado
  qualificationCriteria String? // criterios COMERCIAIS (texto livre) que a IA usa pra SUGERIR qualificado/desqualificado; nunca dado de saude
  qualificationAi       Boolean @default(false) // liga o robo que sugere a classificacao dos leads (a sugestao fica pendente de revisao humana)
  qualificationAutoApprove Boolean @default(false) // aprovacao automatica das sugestoes da IA (explicita e auditavel: grava "aprovacao automatica" no historico)
  tagLeadOrigin        Boolean @default(false) // true = todo contato novo ganha a etiqueta "Lead <campanha> | dd/mm/aaaa" no CRM (src/crm/leadTag.ts)
  silentHandoff        Boolean @default(false) // true = quando a Alice nao sabe responder ela FICA EM SILENCIO (a equipe ve a mensagem nao respondida) em vez de avisar que vai transferir
  humanizedTone        Boolean @default(false) // true = escreve como recepcionista de verdade e nao se apresenta como IA por conta propria (se perguntarem direto, nao nega)
  conciseFirstReply    Boolean @default(false) // true = 1a resposta a um contato novo e CURTA: se apresenta e faz UMA pergunta (nome ou o que quer melhorar), sem despejar informacao
  aliceActive          Boolean @default(true) // false = a Alice esta PAUSADA: nao responde e nao faz recontato; as conversas ficam como nao lidas pra equipe
  quotePrices          Boolean @default(true) // false = a Alice NAO informa valores de procedimento (o preco nem entra no prompt); quem apresenta o investimento e a equipe
  aliceCanBook         Boolean @default(true) // false = a Alice NAO agenda/remarca/cancela/oferece horario: coleta interesse e transfere pra equipe marcar
  requireDepositProof  Boolean @default(false) // so confirma agendamento apos o paciente enviar comprovante do sinal

  // Perfil de atendimento
  businessType         String  @default("clinica")   // clinica (paciente, procedimentos, agenda) | geral (cliente, catalogo/FAQ, sem agenda)
  businessLabel        String?  // rotulo livre do negocio quando businessType = geral (ex: "loja de roupas infantis")
  servicePosture       String  @default("comercial") // comercial (proativo, empurra agenda) | consultivo (avaliacao primeiro, sem pressao)
  clinicKind           String  @default("estetica")  // estetica | medica | ambas - "medica"/"ambas" ativa as travas de seguranca medica
  evaluationFirst      Boolean @default(false) // nunca exige que o paciente saiba o procedimento; sempre oferece avaliacao
  strictBookingRules   Boolean @default(false) // true = procedimento SEM regra de agendamento cadastrada (Procedure.bookingMode / texto aprovado) NAO agenda sozinho nem vira avaliacao: vai para a equipe validar. false = comportamento anterior (agenda o procedimento escolhido)
  notOfferedServices   String? // servicos que a clinica NAO oferece, separados por virgula (ex.: "luz pulsada"): a Alice nunca os oferece nem os trata como equivalentes a outro
  unmappedOffers       String? // ofertas que a clinica ANUNCIA mas ainda nao tem cadastro/mapeamento autorizado (ex.: "Protocolo do Olhar"), separadas por virgula: nunca viram avaliacao nem outro procedimento sozinhas
  allowEmojis          Boolean @default(true)
  schedulingLink       String? // link externo de auto-agendamento (fallback quando a clinica prefere que o paciente marque sozinho)

  // Pesquisa de satisfacao pos-atendimento (NPS + avaliacao no Google)
  npsEnabled       Boolean @default(false)
  npsHoursAfter    Int     @default(24)  // horas depois do atendimento concluido pra perguntar
  npsThreshold     Int     @default(9)   // nota >= isto -> pede avaliacao no Google
  npsMessage       String? // texto da pergunta (vazio = padrao)
  googleReviewUrl  String?
  googleReviewConfirmedAt DateTime? // quando alguem confirmou que o link leva ao estabelecimento certo; sem isso o link NAO e enviado
  googleReviewConfirmedBy String?   // quem confirmou (conta do painel / admin)
  googleReviewPlace       String?   // nome do estabelecimento de destino conferido
  uazapiDownSince     DateTime? // WhatsApp comprovadamente DESCONECTADO desde quando (o provedor disse); null = sem problema conhecido
  uazapiDownReason    String?   // resposta do provedor (curta, sem segredos)
  uazapiDownCheckedAt DateTime? // ultima vez que a conexao foi conferida enquanto marcada como desconectada (sonda a cada poucos minutos, nao a cada envio)
  followupRecoveryHours Int? // recontato: ate quantas horas DEPOIS que a janela abriu ainda pode sair um recontato que nao saiu na hora. null = padrao antigo (tolerancia de 3 dias, o de producao hoje); 0 = nao recupera; 1-72 = N horas. Decisao da clinica
  googleReviewLegacyAllowed Boolean @default(false) // link ja cadastrado ANTES da exigencia de confirmacao: segue enviando por COMPATIBILIDADE, sem dizer que o destino foi conferido

  importStatus    String?   // null | "running" | "completed" - importacao de contatos/historico do WhatsApp
  importStats     String?   // JSON: {found,created,merged,ignored,conversations,partialHistory,contactsInBase}
  importUpdatedAt DateTime?

  // Plano contratado e vigencia (controle comercial - so a administracao da
  // Alice edita, pelo painel adm). Nada e bloqueado automaticamente quando
  // vence: o painel adm so mostra um aviso (ver src/reminders/planExpiry.ts).
  plan               String    @default("prime") // realce | prime | prestige
  planActivatedAt    DateTime?
  planExpiresAt      DateTime? // null = sem prazo definido
  planExpiryNotified Boolean   @default(false) // trava o aviso de "venceu" pra registrar so uma vez

  createdAt     DateTime  @default(now())

  procedures    Procedure[]
  patients      Patient[]
  appointments  Appointment[]
  followUpRules FollowUpRule[]
  broadcasts    BroadcastCampaign[]
  customRules   CustomRule[]
  funnelStages  FunnelStage[]
  staffUsers    StaffUser[]
  locations     ClinicLocation[]
  products      Product[]
  professionals Professional[]
  reminderRules ReminderRule[]
  postProcedureRules PostProcedureRule[]
  preProcedureRules  PreProcedureRule[]
  renewalRules  RenewalRule[]
  birthdayRules BirthdayRule[]
  activityLog   ActivityLog[]
  messageTemplates MessageTemplate[]
  faqs          ClinicFaq[]
  playbooks     Playbook[]
  teachingSuggestions TeachingSuggestion[]
  scheduleBlocks ScheduleBlock[]
  waitlist       WaitlistEntry[]
  tags           Tag[]
  apiKeys        ApiKey[]
  satisfactionSurveys SatisfactionSurvey[]
  uazapiWebhookEvents UazapiWebhookEvent[]
  metaConfig    MetaConfig?
  metaEvents    MetaEvent[]
  learningInsights LearningInsight[]
  googleCalendar GoogleCalendarAccount?
  clinicaExperts ClinicaExpertsAccount?
  learningRunAt  DateTime?

  // Limite de atendimentos/mes (conversas que a Alice atende). null no override
  // = usa o padrao do plano; 0 = ilimitado.
  conversationLimitOverride Int?
  usageMonth        String  @default("") // "YYYY-MM" do contador atual
  usageCount        Int     @default(0)  // atendimentos da Alice no mes corrente
  usageLimitNotified Boolean @default(false)
}

// Integracao com a Meta por clinica (Pixel + API de Conversoes). O token da
// CAPI fica criptografado (AES-256-GCM) em accessTokenEnc e nunca volta pro
// navegador; a UI so ve tokenHint mascarado.
model MetaConfig {
  id                String   @id @default(cuid())
  clinicId          String   @unique
  clinic            Clinic   @relation(fields: [clinicId], references: [id])
  name              String   @default("")
  pixelId           String?  // ID do Pixel / Dataset
  accessTokenEnc    String?  // token da API de Conversoes, criptografado
  tokenHint         String?  // ex "••••••••1234" pra mostrar na tela
  graphVersion      String   @default("v21.0")
  siteUrl           String?  // URL oficial do site (event_source_url de fallback)
  testEventCode     String?  // codigo de "Eventos de teste" da Meta (temporario)
  pixelEnabled      Boolean  @default(false)
  capiEnabled       Boolean  @default(false) // chave mestra dos eventos do servidor

  // API de Conversoes para MENSAGENS COMERCIAIS (WhatsApp / Click-to-WhatsApp): exige WhatsApp Business Platform (WABA) e um dataset ligado a ele.
  // Desligado por padrao; o envio atual ("website") continua exatamente como era.
  messagingEnabled   Boolean @default(false)
  wabaId             String? // WhatsApp Business Account ID
  messagingDatasetId String? // dataset do WABA (GET /{waba_id}/dataset)

  // Mapeamento das etapas do CRM -> pelo stageId (estavel se renomear a coluna)
  stageQualified    String?
  stageDisqualified String?
  stageWon          String?
  stageLost         String?
  stagesIgnored     String   @default("") // stageIds separados por virgula que nao enviam evento

  lastTestAt        DateTime?
  lastTestResult    String?  // "ok" ou resumo do erro (sanitizado)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Fila de saida + auditoria dos eventos enviados pra Meta. (clinicId, eventId)
// unico = garantia de deduplicacao/idempotencia.
model MetaEvent {
  id            String    @id @default(cuid())
  clinicId      String
  clinic        Clinic    @relation(fields: [clinicId], references: [id])
  eventId       String    // id estavel de deduplicacao (ex "lead:<patientId>")
  eventName     String    // Lead | Schedule | CRMStageChanged | DisqualifiedLead | QualifiedLead
  source        String    @default("server") // server (nao ha pixel de navegador nesta versao)
  channel       String    @default("website") // website (pixel/dataset do site) | business_messaging (WhatsApp, via WABA)
  leadId        String?   // Patient.id
  payload       String    // JSON sanitizado do evento (user_data ja com hash, sem token, sem PII crua)
  status        String    @default("pending") // pending | processing | processed | error | dead
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  lastError     String?
  metaResponse  String?   // resposta da Meta, sanitizada (events_received, fbtrace_id, messages)
  testEventCode String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  @@unique([clinicId, eventId])
  @@index([status, nextAttemptAt])
  @@index([clinicId, createdAt])
}

// Fila duravel dos webhooks da UAZAPI. A rota confirma o recebimento rapido
// e o worker processa depois, com idempotencia e novas tentativas.
model UazapiWebhookEvent {
  id         String   @id @default(cuid())
  clinicId   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  externalId String
  payload    String
  status     String   @default("pending") // pending | processing | done | failed
  attempts   Int      @default(0)
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([clinicId, externalId])
  @@index([status, createdAt])
}

// "Mensagens prontas": textos que a Alice reaproveita no atendimento
// (boas-vindas, confirmacao, orientacoes). Suporta as mesmas variaveis de
// template das mensagens programadas.
model MessageTemplate {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  name      String
  body      String
  mode      String   @default("adapt") // adapt = ajusta o tom | exact = envia exatamente assim
  whenToUse String?  // dica de contexto pra Alice saber quando usar
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// "FAQ da clinica": perguntas operacionais com resposta oficial (acesso,
// estacionamento, documentos, politicas). Agenda/catalogo/preco continuam
// vindo das fontes oficiais, nao daqui.
model ClinicFaq {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  question    String
  answer      String
  alternates  String   @default("") // outras formas de fazer a mesma pergunta, uma por linha
  exactAnswer Boolean  @default(false) // true = responder exatamente o texto cadastrado
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// "Roteiros": sequencias de conversa que a Alice conduz passo a passo em
// situacoes especificas (primeiro atendimento, remarcacao, pos-procedimento).
model Playbook {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  name        String
  scriptType  String   @default("livre") // primeiro_atendimento | agendamento | procedimento | preco | objecoes | remarcacao | pos_procedimento | transferir | livre
  triggerText String?  // quando este roteiro deve ser usado
  goal        String?  // objetivo que a Alice precisa cumprir
  steps       String   @default("") // um passo por linha
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Caixa de entrada unica do "O que voce quer ensinar pra Alice hoje?": o
// admin digita em texto livre, uma IA decide o DESTINO certo (regra, roteiro,
// mensagem pronta ou FAQ) e monta o conteudo; fica pendente ate o admin
// revisar e aprovar (ou a IA pedir esclarecimento). Ver src/ai/teach.ts.
model TeachingSuggestion {
  id                 String   @id @default(cuid())
  clinicId           String
  clinic             Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  rawInput           String
  targetType         String   // rule | playbook | template | faq
  status             String   @default("draft") // needs_clarification | draft | approved | discarded
  clarifyingQuestion String?
  payloadJson        String?  // JSON com os campos do targetType (null quando needs_clarification)
  createdAt          DateTime @default(now())

  @@index([clinicId, status])
}

// Historico de atividades da clinica: registro simples de mudancas
// importantes (o que aconteceu, em qual area, quem fez e quando). So pra
// leitura no painel - nenhuma logica depende disso.
model ActivityLog {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  type        String   // slug do evento (ex: human_takeover, appointment_booked)
  area        String   // slug da area (ex: atendimento, agenda, automacoes)
  title       String
  description String?
  actorName   String?  // nome do atendente; null = acao automatica do sistema
  createdAt   DateTime @default(now())

  // Preenchido quando o evento e sobre um lead especifico - alimenta a
  // "Timeline" do card do CRM (ver src/crm/dossier.ts). Null = evento geral
  // da clinica, sem dono (continua no historico normal).
  patientId   String?
  patient     Patient? @relation(fields: [patientId], references: [id])

  @@index([clinicId, createdAt])
  @@index([patientId, createdAt])
}

// Unidade/endereco fisico da clinica. Uma clinica pode ter varias (rede com
// mais de um endereco); a ordem (order) define qual aparece primeiro/e e
// qual e a "principal" no painel.
model ClinicLocation {
  id                  String   @id @default(cuid())
  clinicId            String
  clinic              Clinic   @relation(fields: [clinicId], references: [id])
  name                String
  googleMapsUrl       String?
  website             String?
  timezone            String   @default("America/Sao_Paulo")
  street              String?
  number              String?
  complement          String?
  neighborhood        String?
  city                String?
  state               String?
  zipCode             String?
  country             String   @default("Brasil")
  arrivalInstructions String?
  active              Boolean  @default(true)
  order               Int      @default(0)
  createdAt           DateTime @default(now())
}

// Conta de login do painel. role="admin" enxerga/opera todas as clinicas
// (equipe da Alice, o SaaS); role="client" fica restrita a UMA clinica so
// (dono da clinica cliente, ex: Isac) - fica travado nela em toda a API,
// nunca ve nem acessa dados de outra clinica.
model StaffUser {
  id           String   @id @default(cuid())
  clinicId     String? // null pra contas admin - nao pertencem a uma clinica so
  clinic       Clinic?  @relation(fields: [clinicId], references: [id])
  name         String
  username     String   @unique
  passwordHash String
  role         String   @default("client") // admin | client
  createdAt    DateTime @default(now())
  // Versao da sessao: vai dentro do cookie assinado. Bumpar (troca de senha ou
  // botao "desconectar todos os acessos") invalida na hora todo cookie antigo
  // dessa conta, sem mexer nas outras.
  sessionEpoch Int      @default(0)
  passwordChangedAt DateTime? // quando a senha foi definida/trocada pela ultima vez (diagnostico de "nao consigo entrar")
  loginEvents  LoginEvent[]
  assignedPatients Patient[] @relation("PatientAssignedTo") // leads em que esta conta e a "Responsavel" no card do CRM
}

// Um registro por login bem-sucedido (IP + navegador + quando). So pra
// auditoria e pro admin ver "quem entrou na conta do cliente".
// Tentativas de login que FALHARAM (diagnostico: o motivo e uma dica, nunca a senha). Aparece no modal "Acesso do cliente" do painel adm.
model LoginFailure {
  id        String   @id @default(cuid())
  username  String
  staffId   String?
  clinicId  String?
  reason    String   // usuario_inexistente | senha_incorreta | conta_bloqueada | limite_de_tentativas
  hint      String   @default("")
  ip        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([clinicId, createdAt])
  @@index([username, createdAt])
}

model LoginEvent {
  id        String    @id @default(cuid())
  staffId   String
  staff     StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  clinicId  String? // copiado do StaffUser no momento do login (facilita filtrar)
  ip        String    @default("")
  userAgent String    @default("")
  createdAt DateTime  @default(now())

  @@index([clinicId, createdAt])
  @@index([staffId, createdAt])
}

model Procedure {
  id                 String    @id @default(cuid())
  clinicId           String
  clinic             Clinic    @relation(fields: [clinicId], references: [id])
  name               String
  durationMin        Int       @default(60)
  description        String?

  price              Float?    // valor a vista, em reais; null = nao informado
  priceVariable      Boolean   @default(false) // preco depende de avaliacao presencial
  offerInstallments  Boolean   @default(false)
  maxInstallments    Int?      // ex: 10 -> "10x de R$ X" (calculado a partir de price)
  paymentMethods     String    @default("") // dinheiro,pix,credito,debito separados por virgula
  paymentLink        String?
  pixKey             String?   // chave pix pro pagamento (sinal/procedimento) - separado do link generico acima

  // Contexto pra Alice entender e apresentar o procedimento sem inventar
  // indicacao/beneficio/prazo que a clinica nao cadastrou.
  goals              String?   // objetivos/queixas atendidas, uma por linha
  benefits           String?   // beneficios que podem ser afirmados, um por linha
  aliases            String?   // outros nomes/formas de pedir, separados por virgula
  resultTimeline     String?   // quando o resultado costuma aparecer
  includedQuantity   String?   // quantidade INCLUIDA na oferta, dado comercial aprovado (ex.: "50 UI"). NAO e recomendacao individual de aplicacao e nao vale para outras ofertas/marcas

  // true = varios pacientes podem ocupar o MESMO horario com o mesmo
  // profissional pra esse procedimento (ex.: aplicacao/injetavel atendido
  // por ordem de chegada, sem hora marcada individual - a clinica so quer
  // um registro de controle por paciente). Nao conta como conflito de
  // agenda contra outro agendamento do MESMO procedimento; continua
  // conflitando normalmente com procedimentos que nao tem essa flag.
  allowConcurrentBooking Boolean @default(false)
  ceId           Int?      // id do procedimento no Clinica Experts (null = nao vinculado)
  internalOnly   Boolean   @default(false) // true = existe so pra agendamentos importados do Clinica Experts (retoque, cortesia...): a Alice NAO oferece nem agenda (src/clinicaexperts/autoLink.ts)
  bookingMode    String?   // direct = agenda direto | evaluation = exige avaliacao previa | null = a clinica ainda nao definiu (ver ai/conduct.ts: bookingModeOf)

  appointments  Appointment[]
  professionals Professional[] @relation("ProfessionalProcedures")
  waitlist      WaitlistEntry[]
  photos        ProcedurePhoto[]
}

// Fotos de exemplo (ex.: antes/depois) que a Alice pode enviar quando o
// paciente aceitar ver resultado ou pedir foto - ver tool send_procedure_photos
// em ai/alice.ts. Sem fotos cadastradas, a Alice nao promete nem inventa imagem.
model ProcedurePhoto {
  id          String    @id @default(cuid())
  procedureId String
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  dataUrl     String    // data URI (base64) da foto, mesmo padrao do photoUrl de Product/Professional
  caption     String?   // ex: "Antes", "Depois", "6 meses apos"
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([procedureId])
}

// Diretorio simples de profissionais da clinica (nome, foto, bio, quais
// procedimentos cada um faz). Sem agenda/turno proprio ainda - a atribuicao
// a um agendamento e manual (ver Appointment.professionalId).
model Professional {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  name      String
  title     String?  // tratamento usado pela Alice (ex.: "Dra."); vazio = so o nome. NAO indica formacao: "Dra." nao significa medica (ver qualification)
  qualification String? // FORMACAO profissional informada pela clinica (ex.: "Biomedica", "Medica", "Esteticista"); null = nao informada (a Alice nao deduz formacao pelo titulo)
  instagram String?
  bio       String?
  color     String?  // cor de identificacao (ex: na agenda), hex
  photoUrl  String?  // data URI (base64) da foto enviada
  ceUuid    String?  // uuid do profissional no Clinica Experts (null = nao vinculado)
  active    Boolean  @default(true)
  // Agenda propria do profissional. null = herda o expediente da clinica.
  workDays      String? // dias de atendimento (0=domingo..6=sabado), separados por virgula
  workStartHour Int?
  workEndHour   Int?
  lunchStartHour Int? // sobrescreve o intervalo da clinica pra esse profissional; null = herda
  lunchEndHour   Int?
  // Minutos complementando as horas acima - so tem efeito junto de uma hora
  // propria (acima); se a hora for null (herda da clinica), o minuto tambem
  // e ignorado e vem da clinica junto. Default 0 = sem mudanca de comportamento.
  workStartMinute  Int @default(0)
  workEndMinute    Int @default(0)
  lunchStartMinute Int @default(0)
  lunchEndMinute   Int @default(0)
  createdAt DateTime @default(now())

  procedures     Procedure[]   @relation("ProfessionalProcedures")
  appointments   Appointment[]
  scheduleBlocks ScheduleBlock[]
  waitlist       WaitlistEntry[]
}

// Produto fisico vendido pela clinica (ex: home care), separado de procedimentos.
model Product {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  name        String
  price       Float?
  description String?
  photoUrl    String?  // data URI (base64) da foto enviada
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Patient {
  id            String    @id @default(cuid())
  clinicId      String
  clinic        Clinic    @relation(fields: [clinicId], references: [id])
  phone         String    // numero do paciente no WhatsApp
  name          String?
  email         String?
  cpf           String?
  notes         String?   // anotacoes livres da equipe sobre o paciente
  birthDate     DateTime? // data de nascimento (so dia/mes importa pro aniversario)
  funnelStage   String    @default("novo_lead") // ver src/crm/stages.ts para a lista de etapas
  optedOut      Boolean   @default(false) // paciente pediu pra nao receber mensagens (LGPD) - trava automacoes
  optedOutAt    DateTime?
  active          Boolean @default(true)  // paciente ainda em acompanhamento com a clinica ou nao
  hasPrescription Boolean @default(false) // controla se os lembretes de renovacao de receita aparecem/valem
  phoneContactName String? // nome com que o paciente foi salvo na agenda do celular da clinica (null = ainda nao salvo)
  ceUuid          String?  // uuid do paciente no Clinica Experts (cache pra nao buscar toda vez)
  attendees       Attendee[] @relation("AttendeeContact")

  // Atribuicao de campanha Meta, capturada na criacao do lead (Click-to-WhatsApp).
  // Fica vinculada ao lead pra eventos posteriores do CRM baterem com o anuncio.
  metaFbc        String?
  metaFbp        String?
  metaFbclid     String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  adCampaignName String?
  adsetName      String?
  adName         String?
  sourceUrl      String?

  createdAt     DateTime  @default(now())

  // Classificacao comercial ATUAL do lead (a ultima CONFIRMADA em LeadClassification). Nunca "qualificado" e "desqualificado" ao mesmo tempo.
  leadClass     String?   // em_qualificacao | qualificado | desqualificado (null = ainda sem classificacao)
  leadClassAt   DateTime?
  adAttributions AdAttribution[]
  leadClassifications LeadClassification[]

  // Card do CRM (modal "detalhes do lead" no quadro): dados comerciais que nao
  // vem da conversa - a equipe preenche na mao. Nada disso afeta a Alice.
  estimatedValue  Float?    // valor estimado do negocio, em reais
  leadTemperature String?   // frio | morno | quente (null = sem temperatura)
  assignedToId    String?
  assignedTo      StaffUser? @relation("PatientAssignedTo", fields: [assignedToId], references: [id])
  nextActionAt    DateTime? // proxima acao comercial marcada (retorno, ligacao...)
  nextActionNote  String?   // o que fazer nessa proxima acao
  crmHidden       Boolean   @default(false) // "Remover do CRM": sai do quadro sem apagar contato/historico

  // Preenchidos sozinhos a partir da conversa (robo de resumo do CRM), pra
  // equipe saber o que o lead queria sem reler o historico inteiro. So sai do
  // que o paciente falou - nunca inventado.
  contactReason      String?   // "Quer saber valores do botox."
  interestNote       String?   // procedimento(s) de interesse, separados por virgula
  conversationSummary String?  // resumo curto do que o paciente falou
  crmSummaryAt       DateTime? // quando o resumo foi gerado (compara com lastMessageAt)

  // Perfil comercial (preenchido pelo robo de resumo + sinais de intencao da conversa). So o que a pessoa disse.
  urgency             String?   // agora | este_mes | depois (quando pretende fazer)
  objections          String?   // preco,medo,dor,tempo,indecisao (separadas por virgula)
  refusedProcedures   String?   // procedimentos que ela disse que NAO quer (separados por virgula) - nao oferecer de novo
  preferredProfessional String? // profissional preferida
  preferredPeriod     String?   // manha | tarde | noite
  preferredDays       String?   // dias da semana que funcionam (texto livre curto)
  askedPriceAt        DateTime? // sinais de intencao: ultima vez que perguntou valor / parcelamento / horario
  askedInstallmentsAt DateTime?
  askedScheduleAt     DateTime?
  hotAlertedAt        DateTime? // quando a equipe foi avisada de "lead quente parado" (uma vez por sinal)
  noInterest          Boolean   @default(false) // disse que nao tem (mais) interesse: sem recontato nem campanha
  noInterestAt        DateTime?
  briefingNotes       String?   // MEMORIA DO LEAD: notas curtas escritas por IA com o que vale lembrar (ver ai/leadBriefing.ts); atualizada quando algo relevante acontece
  briefingNotesAt     DateTime?
  callbackAt          DateTime? // pediu pra retomar numa data ("me chama depois do dia 20")
  callbackNote        String?

  conversations Conversation[]
  appointments  Appointment[]
  broadcastRecipients BroadcastRecipient[]
  birthdaySent  BirthdaySent[]
  waitlist      WaitlistEntry[]
  tags          PatientTag[]
  satisfactionSurveys SatisfactionSurvey[]
  activityLogs  ActivityLog[]
  prescriptionReminders PrescriptionReminder[]

  @@unique([clinicId, phone])
  @@index([clinicId, createdAt])
}

// Lembrete de renovacao de receita: a equipe escolhe uma data e escreve a
// mensagem (so aparece se o paciente tiver hasPrescription); o robo manda
// automaticamente nesse dia, uma unica vez. Ate 2 por paciente - a UI que
// limita, sem trava no banco porque isso nao muda a logica de envio.
model PrescriptionReminder {
  id        String    @id @default(cuid())
  patientId String
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date      DateTime  // dia (meia-noite UTC - so a data importa, mesmo padrao do birthDate)
  message   String
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([date, sentAt])
}

// Etiqueta colorida atribuivel a contatos (ex: "VIP", "Indicacao", "Botox").
model Tag {
  id        String       @id @default(cuid())
  clinicId  String
  clinic    Clinic       @relation(fields: [clinicId], references: [id])
  label     String
  color     String       @default("#8b5cf6")
  system    Boolean      @default(false) // etiqueta automatica (origem/qualificacao): mantida pelo sistema
  createdAt DateTime     @default(now())

  patients  PatientTag[]

  @@unique([clinicId, label])
}

model PatientTag {
  patientId String
  tagId     String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([patientId, tagId])
  @@index([tagId])
}

model Conversation {
  id                String    @id @default(cuid())
  patientId         String
  patient           Patient   @relation(fields: [patientId], references: [id])
  status            String    @default("active") // active | qualified | scheduled | closed
  humanTakeover     Boolean   @default(false) // true = Alice para de responder, atendente assumiu
  handoffReason     String?   // motivo curto do ultimo handoff para humano (ex: "pedido de desconto")
  staffTouchedAt    DateTime? // ultima vez que uma PESSOA da equipe agiu na conversa (respondeu pelo painel/celular ou assumiu); base do "Alice volta se a equipe demorar"
  handoffPending    Boolean   @default(false) // "nao lida": precisa de atencao da equipe e ninguem abriu ainda
  archived          Boolean   @default(false) // conversa arquivada (sai da lista principal), estilo WhatsApp
  aliceMonth        String    @default("")    // "YYYY-MM" da ultima vez que a Alice atendeu (conta 1 atendimento/mes)
  lastFollowUpOrder Int       @default(0) // ultima etapa de recontato ja enviada (0 = nenhuma)
  replyDueAt        DateTime? // agrupamento (replyDelaySeconds > 0): quando a resposta agrupada vence. Persistido para sobreviver a reinicio; null = nada aguardando
  replyFirstAt      DateTime? // quando a primeira mensagem do grupo chegou (limite de espera total)
  replyClaimedAt    DateTime? // quem esta gerando a resposta agrupada agora (reivindicacao atomica; velha = o processo caiu)
  lastMessageAt     DateTime  @default(now())
  recontactVerdict  String?   // veredito da IA sobre recontatar esta conversa: yes | no
  recontactReason   String?   // motivo curto dado pela IA
  recontactJudgedFor DateTime? // createdAt da ultima mensagem que a IA avaliou (se a conversa nao mudou, reaproveita o veredito)
  recontactFingerprint String? // impressao digital do contexto (mensagens, agenda, equipe, retorno combinado) + etapa em que o veredito foi dado
  recontactJudgedAt  DateTime? // quando o veredito foi dado: vale por poucas horas (o juiz tambem leva o tempo em conta)
  unansweredAlertAt DateTime? // quando a equipe foi avisada de que o paciente ficou sem resposta (uma vez por mensagem)
  createdAt         DateTime  @default(now())

  messages          Message[]
  followUpSent      FollowUpSent[]

  @@index([archived, lastMessageAt])
  @@index([patientId])
  @@index([replyDueAt])
}

// Cascata de recontato: dispara mensagens automaticas quando o paciente fica
// um tempo sem responder. `order` mantem a sequencia da cascata (recontato 1,
// 2, 3...); cada etapa tem seu proprio nome, tempo de silencio e opcoes.
model FollowUpRule {
  id                 String  @id @default(cuid())
  clinicId           String
  clinic             Clinic  @relation(fields: [clinicId], references: [id])
  order              Int     // 1, 2, 3... define a sequencia da cascata
  name               String  @default("")
  afterDays          Int     // (legado) dias de silencio - mantido; o efetivo e afterMinutes
  afterMinutes       Int     @default(0) // silencio total em minutos pra disparar (0 = usa afterDays)
  message            String  // suporta as variaveis de template ({primeiro_nome} etc)
  repeatMode         String  @default("every_silence") // every_silence | once
  skipIfHumanTakeover Boolean @default(false)
  skipIfUpcomingAppt Boolean @default(true)
  sendWindowStart    Int?    // hora local (0-23) de inicio da janela de envio; null = qualquer horario
  sendWindowEnd      Int?
  nextDayHour        Int?    // 0-23: recontato no DIA SEGUINTE a ultima mensagem da pessoa, as N horas (em vez de contar 24h corridas); null = usa o silencio em minutos
  active             Boolean @default(true)

  sentLogs           FollowUpSent[]

  @@unique([clinicId, order])
}

// So usado quando repeatMode = "once": trava um envio dessa regra por conversa
// pra sempre (no "every_silence" a cascata reinicia a cada novo silencio e essa
// tabela e ignorada).
model FollowUpSent {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  ruleId         String
  rule           FollowUpRule @relation(fields: [ruleId], references: [id])
  sentAt         DateTime     @default(now())

  @@unique([conversationId, ruleId])
}

// Mensagem agendada em massa para a base de contatos (ou um estagio do funil).
// O envio real acontece aos poucos (ver src/crm/broadcast.ts) pra nao estourar
// limite de taxa do WhatsApp e respeitar o horario comercial da clinica.
model BroadcastCampaign {
  id           String   @id @default(cuid())
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id])
  title        String
  message      String   // suporta {nome}/{primeiro_nome}/{nome_completo}/{telefone}/{endereco}/{unidade}/{data_hora}
  targetStage  String?  // usado so quando targetMode = "stage" - id de src/crm/stages.ts
  targetMode   String   @default("all") // all | stage | contacts | reactivation
  targetConfig String?  // JSON extra por targetMode. reactivation: {"procedureIds":[...],"monthsSince":6}
  scheduledFor DateTime
  status       String   @default("scheduled") // scheduled | sending | completed | cancelled
  createdAt    DateTime @default(now())

  recipients   BroadcastRecipient[]
}

model BroadcastRecipient {
  id         String            @id @default(cuid())
  campaignId String
  campaign   BroadcastCampaign @relation(fields: [campaignId], references: [id])
  patientId  String
  patient    Patient           @relation(fields: [patientId], references: [id])
  status     String            @default("pending") // pending | sent | failed
  sentAt     DateTime?

  @@unique([campaignId, patientId])
}

// Regra de atendimento gerada a partir de um texto livre do admin ("descreva
// a mudanca"). A IA classifica numa categoria e escreve a instrucao final, ou
// devolve uma pergunta se faltar informacao. So entra no prompt da Alice
// depois que o admin aprova (status=active).
// "Aprendizado da Alice": o robô noturno lê as conversas, tira lições (resposta
// que um humano deu, erro que a Alice cometeu, jeito de falar da equipe) e cria
// insights aqui. NADA afeta a Alice até um humano aprovar - aprovar promove o
// insight pra ClinicFaq / CustomRule de verdade (ou aposenta a regra alvo).
model LearningInsight {
  id            String   @id @default(cuid())
  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  kind          String   // faq | rule | style | retire
  status        String   @default("pending") // pending | approved | rejected
  title         String   // resumo curto pra lista
  trigger       String   @default("") // "quando o cliente pergunta X" (vira a pergunta da FAQ)
  suggestion    String   // a lição / resposta / regra sugerida
  category      String?  // categoria do CustomRule (kind=rule/style)
  targetType    String?  // kind=retire: "rule" | "faq"
  targetId      String?  // kind=retire: id do alvo
  source        String   // handoff | failure | style | contradiction
  evidenceCount Int      @default(1)
  exampleConvId String?
  fingerprint   String   @default("") // normalizado, pra deduplicar
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?
  appliedRefId  String?  // id do ClinicFaq/CustomRule criado ao aprovar

  @@index([clinicId, status])
}

model CustomRule {
  id                 String   @id @default(cuid())
  clinicId           String
  clinic             Clinic   @relation(fields: [clinicId], references: [id])
  category           String   // agendamento | pagamento | tom_de_voz | chamar_equipe | procedimentos
  rawInput           String   // o que o admin digitou originalmente
  instruction        String?  // regra final pronta pra entrar no prompt (null se ainda precisa esclarecer)
  clarifyingQuestion String?  // pergunta da IA quando falta informacao
  status             String   @default("draft") // needs_clarification | draft | active
  createdAt          DateTime @default(now())
}

// Etapas do funil kanban, editaveis por clinica. Quando uma clinica ainda
// nao tem nenhuma, o app cria as 10 padrao automaticamente na primeira
// consulta (ver src/crm/stages.ts). stageId e o slug estavel guardado em
// Patient.funnelStage - editar label/color/kind nao quebra os pacientes ja
// nessa etapa, so renomear/apagar o stageId em si exigiria migrar os dados.
model FunnelStage {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  stageId  String // slug usado em Patient.funnelStage
  label    String
  color    String
  kind     String // aberta | avaliacao_agendada | ganho | pos_procedimento | perdido
  order    Int

  @@unique([clinicId, stageId])
}

// Chave de API para integracao server-to-server (ver src/api/external/).
// Cada chave pertence a UMA clinica; o parceiro nunca envia clinicId.
model ApiKey {
  id            String    @id @default(cuid())
  clinicId      String
  clinic        Clinic    @relation(fields: [clinicId], references: [id])
  name          String
  lookup        String    @unique // primeiros 14 chars da chave (para achar rapido)
  hash          String              // sha-256 (hex) da chave completa
  scopes        String              // escopos separados por virgula
  createdByName String?
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  idempotencyKeys ApiIdempotencyKey[]

  @@index([clinicId])
}

// Guarda a resposta de uma requisicao com Idempotency-Key para repetir a mesma
// resposta se o parceiro reenviar a chamada.
model ApiIdempotencyKey {
  id         String   @id @default(cuid())
  apiKeyId   String
  apiKey     ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  key        String
  statusCode Int
  body       String   // JSON serializado da resposta
  createdAt  DateTime @default(now())

  @@unique([apiKeyId, key])
}

// Pesquisa de satisfacao disparada X horas depois de um atendimento concluido.
// A Alice pergunta a nota na conversa e, se boa, manda o link de avaliacao.
model SatisfactionSurvey {
  id             String    @id @default(cuid())
  clinicId       String
  clinic         Clinic    @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId  String?
  score          Int?      // 0-10
  comment        String?
  askedAt        DateTime  @default(now())
  answeredAt     DateTime?
  reviewLinkSent Boolean   @default(false) // true = o link do Google FOI na mensagem
  answeredByMessageId String? // id da mensagem da pessoa que trouxe a nota (a mesma mensagem nunca grava duas vezes)
  band           String?   // baixa | neutra | positiva
  hasComplaint   Boolean   @default(false) // a nota veio com reclamacao: sem link nem convite de indicacao
  linkState      String?   // enviado | pendente_confirmacao | ausente | invalido | nao_aplicavel

  @@index([clinicId, askedAt])
  @@index([patientId, answeredAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String       // user | assistant | human | system (system = evento de transferencia, nao e mensagem de chat)
  content        String
  mediaType      String?      // image | video | document | audio (quando a mensagem tem anexo)
  mediaUrl       String?      // data URI do anexo (para mostrar no painel)
  mediaName      String?      // nome do arquivo (documentos)
  authorName     String?      // nome do atendente logado que enviou/transferiu (null = Alice, ou ninguem logado)
  externalId     String?      // id da mensagem no WhatsApp (so mensagens recebidas): evita gravar duas vezes quando o webhook e reprocessado
  deliveryStatus String?      // so respostas da Alice: pending (gravada, ainda nao enviada) | sent | failed. null = nao se aplica / legado
  replyContext   String?      // so respostas da Alice AINDA NAO entregues: resumo compacto (JSON) do que a geracao fez/recebeu das ferramentas, para a entrega validar o texto mesmo apos reinicio. Apagado no estado final
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([role, createdAt])
  @@index([externalId])
}

model Appointment {
  id             String        @id @default(cuid())
  clinicId       String
  clinic         Clinic        @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id])
  procedureId    String
  procedure      Procedure     @relation(fields: [procedureId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  scheduledAt    DateTime
  status         String        @default("confirmed") // confirmed | completed | cancelled | no_show
  cancelledAt    DateTime?     // quando virou "cancelled" (null = cancelado antes deste registro existir: origem NAO comprovada)
  cancelSource   String?       // paciente_whatsapp | equipe_painel | api_externa | ce_cancelada (CE disse cancelada) | ce_apagada (CE nao tem mais a reserva: NAO prova cancelamento) | sistema_desfeito (a Alice desfez porque o CE recusou)
  source         String?       // whatsapp | instagram | presencial | telefone (null = nao informado)
  googleEventId  String?       // id do evento espelhado no Google Agenda (null = nao sincronizado)
  ceBookingUuid  String?       // uuid do agendamento espelhado no Clinica Experts (null = nao sincronizado)
  patientConfirmed Boolean     @default(false) // paciente confirmou presenca (resposta ao lembrete)
  confirmedAt    DateTime?
  createdAt      DateTime      @default(now())

  // ---- Clinica Experts (21/10/2026): a reserva la e a verdade; estes campos guardam o que ELE disse e o que ainda falta sincronizar ----
  endsAt         DateTime?     // fim da reserva (ends_at do CE ou inicio + duracao): e o que ocupa a agenda; null = derivar da duracao do procedimento (registros antigos)
  ceStatus       String?       // estado BRUTO do CE (scheduled | confirmed | done | canceled | noshow | rescheduled | waiting | progress | reserved | ...): nunca reescrito pela Alice
  ceUpdatedAt    DateTime?     // updated_at da reserva no CE na ultima leitura (versao: distingue cancelamento nosso nao sincronizado de reativacao da recepcao)
  ceSyncedAt     DateTime?     // ultima leitura bem-sucedida desta reserva no CE
  ceCancelState  String?       // null | pending (cancelado aqui; o CE ainda nao confirmou) | confirmed (o CE confirmou)
  cePresenceState String?      // null | pending (paciente confirmou; falta o PATCH /confirm no CE) | synced | skipped (sem vinculo)
  cePresenceAt   DateTime?     // quando a confirmacao de presenca foi sincronizada com o CE
  attendeeId     String?       // quem E ATENDIDO quando nao e a pessoa do WhatsApp (ex.: marido): null = a propria pessoa do contato
  attendee       Attendee?     @relation(fields: [attendeeId], references: [id])
  bookedByPatientId String?    // quem pediu a reserva (quando difere de patientId)
  procedures     AppointmentProcedure[]

  reminders      ReminderSent[]
  postProcedureSent PostProcedureSent[]
  preProcedureSent  PreProcedureSent[]
  renewalSent    RenewalSent[]

  @@index([clinicId, scheduledAt])
  @@index([patientId, scheduledAt])
  @@index([clinicId, ceBookingUuid])
}

// TODOS os procedimentos de uma reserva do Clinica Experts (uma reserva pode ter varios: avaliacao + procedimento, dois procedimentos...). Appointment.procedureId continua sendo o
// principal (compatibilidade); aqui fica o conjunto, para preparo, pos-procedimento, mensagens e duracao nao perderem informacao.
model AppointmentProcedure {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  procedureId   String?     // procedimento local (null = o CE tem, a Alice ainda nao vinculou)
  ceProcedureId Int?
  name          String
  durationMin   Int?
  position      Int         @default(0)

  @@index([appointmentId])
}

// Pessoa ATENDIDA que compartilha o telefone de quem conversa (marido, filha...). Nao e um contato de WhatsApp: as mensagens vao para o telefone do contato e citam o nome do atendido. Se o
// acompanhante tem telefone PROPRIO, ele vira um Patient normal (nao um Attendee). Nunca se funde com outro cadastro automaticamente.
model Attendee {
  id               String        @id @default(cuid())
  clinicId         String
  contactPatientId String
  contactPatient   Patient       @relation("AttendeeContact", fields: [contactPatientId], references: [id])
  name             String
  relation         String?       // como a pessoa o descreveu ("marido"); so informacao
  ceUuid           String?       // uuid DESTA pessoa no Clinica Experts (nunca o do contato)
  birthDate        DateTime?
  createdAt        DateTime      @default(now())
  appointments     Appointment[]

  @@index([clinicId, contactPatientId])
  @@index([ceUuid])
}

// Tentativa de criar/alterar/cancelar/confirmar uma reserva no Clinica Experts. Existe para o RESULTADO INCERTO (rede caiu, tempo esgotado, 5xx): a Alice nunca recria as cegas; o
// reconciliador procura la uma reserva que combine em TODOS os campos (paciente, profissional, procedimentos, inicio e fim) e so entao vincula; sem prova, a equipe confere.
model CeBookingAttempt {
  id             String    @id @default(cuid())
  clinicId       String
  appointmentId  String
  kind           String    // create | reschedule | cancel | confirm
  state          String    // pending | created | uncertain | linked_existing | failed | unresolved
  startsAt       DateTime?
  endsAt         DateTime?
  professionalUuid String?
  patientUuid    String?
  procedureCeIds String?   // json [ids]
  ceBookingUuid  String?
  attempts       Int       @default(1)
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resolvedAt     DateTime?

  @@index([clinicId, state])
  @@index([appointmentId, kind])
}

// Conexao da clinica com o Google Agenda (OAuth). Uma por clinica.
//
// Serve pros dois lados: o que a Alice agenda vira evento no Google
// (syncOut) e o que ja esta no Google ocupa a agenda da Alice (blockBusy),
// pra o compromisso pessoal do profissional nao virar horario livre.
//
// Os tokens ficam criptografados (mesmo AES-256-GCM do token da Meta) e
// nunca voltam pro navegador.
model GoogleCalendarAccount {
  id              String    @id @default(cuid())
  clinicId        String    @unique
  clinic          Clinic    @relation(fields: [clinicId], references: [id])
  googleEmail     String?   // conta conectada, so pra exibir no painel
  calendarId      String    @default("primary")
  refreshToken    String    // criptografado
  accessToken     String?   // criptografado; cache ate expirar
  accessExpiresAt DateTime?
  syncOut         Boolean   @default(true)
  blockBusy       Boolean   @default(true)
  lastSyncAt      DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
}

// Bloqueio de agenda: feriado, almoco, folga, manutencao de equipamento.
// professionalId null = bloqueia a clinica inteira nesse intervalo.
model ScheduleBlock {
  id             String        @id @default(cuid())
  clinicId       String
  clinic         Clinic        @relation(fields: [clinicId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  reason         String        @default("")
  createdAt      DateTime      @default(now())

  @@index([clinicId, startsAt])
}

// Lista de espera: paciente que quis um horario indisponivel. Quando abre uma
// vaga (cancelamento) a Alice avisa o primeiro da fila compativel.
model WaitlistEntry {
  id             String        @id @default(cuid())
  clinicId       String
  clinic         Clinic        @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  procedureId    String?
  procedure      Procedure?    @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  preferredNote  String        @default("") // "quinta de manha" - texto livre do paciente
  status         String        @default("waiting") // waiting | notified | converted | cancelled
  createdAt      DateTime      @default(now())
  notifiedAt     DateTime?

  @@index([clinicId, status])
}

// Lembrete automatico de consulta, configuravel (pode ter mais de um, ex: 24h
// antes e 2h antes). ReminderSent evita mandar o mesmo lembrete duas vezes
// pro mesmo agendamento.
model ReminderRule {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  hoursBefore Int      @default(24)
  dayOffset   Int?     // se preenchido, horario FIXO: 1 = dia anterior, 0 = no proprio dia (usa sendHour/sendMinute); null = "hoursBefore" horas antes
  sendHour    Int?
  parentRuleId String? // se preenchido, esta regra so manda pra quem recebeu a regra-mae e NAO confirmou (nao respondeu desde o envio e patientConfirmed=false)
  pauseMinSec Int      @default(15) // pausa minima (s) entre um paciente e outro nos envios em janela
  pauseMaxSec Int      @default(45)
  scheduledChange String? // JSON {from, sendHour, sendMinute, sendEndHour, pauseMinSec, pauseMaxSec}: mudanca de janela/pausa que entra sozinha na data 'from'
  sendEndHour Int?     // fim da JANELA de envio (hora cheia): com ele, a regra manda de sendHour:sendMinute ate sendEndHour, espalhando os envios
  sendMinute  Int      @default(0)
  message     String   // suporta as mesmas variaveis do broadcast + {procedimento}/{profissional}/{hora}
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  sentLogs    ReminderSent[]
}

model ReminderSent {
  id            String       @id @default(cuid())
  appointmentId String
  appointment   Appointment  @relation(fields: [appointmentId], references: [id])
  ruleId        String
  rule          ReminderRule @relation(fields: [ruleId], references: [id])
  sentAt        DateTime     @default(now())

  @@unique([appointmentId, ruleId])
}

// Mensagem automatica de acompanhamento pos-procedimento (cuidados, checar
// como o paciente esta). Dispara X horas/dias depois do agendamento, so pra
// procedimentos concluidos (se onlyIfCompleted) e so pros procedimentos
// escolhidos (procedureIds vazio = todos).
model PostProcedureRule {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id])
  name            String
  message         String
  intervalValue   Int      @default(1)
  intervalUnit    String   @default("days") // hours | days
  onlyIfCompleted Boolean  @default(true)
  procedureIds    String   @default("") // vazio = todos; senao ids separados por virgula
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  sentLogs        PostProcedureSent[]
}

model PostProcedureSent {
  id            String            @id @default(cuid())
  appointmentId String
  appointment   Appointment       @relation(fields: [appointmentId], references: [id])
  ruleId        String
  rule          PostProcedureRule @relation(fields: [ruleId], references: [id])
  sentAt        DateTime          @default(now()) // (momento da RESERVA; so vale como envio quando state = sent)
  // Estado real da etapa: reserved (reservada, provedor NAO chamado) | sending (tentativa iniciada: o provedor pode ter sido chamado) | sent | unconfirmed (resultado incerto: nunca
  // reenvia as cegas) | retry (falha temporaria / WhatsApp fora / revisao fora: tenta de novo) | vetoed | blocked | duplicate | failed_permanent | legacy (registro anterior a esta
  // coluna: so prova que a etapa foi reservada, nao que a mensagem saiu; nunca reaberto nem reenviado)
  state         String            @default("legacy")
  reservedAt    DateTime?
  attemptedAt   DateTime?
  finalAt       DateTime?
  attempts      Int               @default(0)
  note          String?

  @@unique([appointmentId, ruleId])
  @@index([state, reservedAt])
}

// Pre-procedimento: orientacoes de preparo enviadas LOGO APOS a cliente confirmar o horario (a confirmacao feita na conversa com a
// Alice). So pros procedimentos escolhidos (procedureIds vazio = todos). Uma vez por agendamento por regra (PreProcedureSent).
model PreProcedureRule {
  id           String   @id @default(cuid())
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id])
  name         String
  message      String   // comeca agradecendo a confirmacao; aceita {primeiro_nome} e as demais variaveis das mensagens automaticas
  procedureIds String   @default("") // vazio = todos; senao ids separados por virgula
  sendHoursBefore Int?  // preenchido (ex.: 48): o texto sai sozinho tantas horas antes do atendimento (job); vazio = so apos a cliente confirmar na conversa
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  sentLogs     PreProcedureSent[]
}

model PreProcedureSent {
  id            String           @id @default(cuid())
  appointmentId String
  appointment   Appointment      @relation(fields: [appointmentId], references: [id])
  ruleId        String
  rule          PreProcedureRule @relation(fields: [ruleId], references: [id])
  sentAt        DateTime         @default(now()) // (historico: momento da RESERVA; so vale como envio quando state = sent)
  // Estado real da etapa: reserved (reservada, provedor NAO chamado) | queued (virou resposta na conversa; a entrega da mensagem diz o resto) | sending (tentativa iniciada,
  // provedor pode ter sido chamado) | sent | unconfirmed (resultado incerto: nunca reenvia as cegas) | failed (tenta de novo) | failed_permanent | blocked | vetoed | superseded | expired
  state         String           @default("sent")
  channel       String?          // resposta | antecipado | recuperacao
  messageId     String?          // mensagem da conversa que carrega o preparo (canal resposta)
  reservedAt    DateTime?
  attemptedAt   DateTime?
  finalAt       DateTime?
  attempts      Int              @default(0)
  reevaluateAt  DateTime?
  note          String?

  @@unique([appointmentId, ruleId])
  @@index([state, reservedAt])
}

// Renovacao: retoma o contato meses/anos depois do fim do atendimento pra
// renovar um procedimento periodico (botox, preenchimento etc). Mesma
// mecanica do pos-procedimento, so muda a escala de tempo (limite 2 anos).
model RenewalRule {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id])
  name            String
  message         String
  intervalValue   Int      @default(1)
  intervalUnit    String   @default("months") // months | years
  onlyIfCompleted Boolean  @default(true)
  procedureIds    String   @default("") // vazio = todos
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  sentLogs        RenewalSent[]
}

model RenewalSent {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  ruleId        String
  rule          RenewalRule @relation(fields: [ruleId], references: [id])
  sentAt        DateTime    @default(now())

  @@unique([appointmentId, ruleId])
}

// Mensagem automatica de parabens no dia do aniversario do paciente (usa
// Patient.birthDate). BirthdaySent trava um envio por regra/paciente/ano.
model BirthdayRule {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  name      String
  message   String
  sendHour  Int      @default(9) // hora local da clinica pra disparar
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  sentLogs  BirthdaySent[]
}

model BirthdaySent {
  id        String       @id @default(cuid())
  // state: reserved (reservado, provedor NAO chamado) | sent (aceito pelo provedor) | unconfirmed (resultado incerto: nunca reenvia) | failed_permanent (numero sem WhatsApp) | legacy (registro antigo: so prova a reserva)
  state     String       @default("legacy")
  patientId String
  patient   Patient      @relation(fields: [patientId], references: [id])
  ruleId    String
  rule      BirthdayRule @relation(fields: [ruleId], references: [id])
  year      Int
  sentAt    DateTime     @default(now())

  @@unique([patientId, ruleId, year])
}

// Integracao com o Clinica Experts (sistema de agenda da clinica): a Alice le a
// disponibilidade real de la e espelha os agendamentos dela. Token da API
// criptografado (mesma chave da Meta/Google), nunca volta pro navegador.
model ClinicaExpertsAccount {
  id            String    @id @default(cuid())
  clinicId      String    @unique
  clinic        Clinic    @relation(fields: [clinicId], references: [id])
  tokenEnc      String
  tokenHint     String?   // ex "••••••••1234" pra mostrar na tela
  syncOut       Boolean   @default(true)  // cria/remarca/cancela la o que a Alice agenda
  blockBusy     Boolean   @default(true)  // so oferece horario que o Clinica Experts diz estar livre
  lastSyncAt    DateTime?
  lastCatalogAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
}

// Concessao de tarefa agendada: so UMA copia do servidor roda cada tarefa por vez (ver src/jobs/lock.ts).
model JobLock {
  name      String   @id
  holder    String
  expiresAt DateTime
}

// ---------------------------------------------------------------------------
// ATRIBUICAO DE ANUNCIOS (Click-to-WhatsApp). Uma linha por ENTRADA atribuivel (um clique/anuncio): o mesmo contato pode voltar por outro anuncio sem
// apagar a origem anterior. Primeira origem = a mais antiga; origem da conversa atual = a mais recente; a conversao e ligada a uma entrada
// (LeadClassification.attributionId). Nunca se infere anuncio por palavra-chave: so existe linha quando o referral trouxe source_id ou ctwa_clid.
// ---------------------------------------------------------------------------
model AdAttribution {
  id                String   @id @default(cuid())
  clinicId          String
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  conversationId    String?
  messageExternalId String?  // id da mensagem no WhatsApp (reprocessar o webhook nao grava de novo)
  receivedAt        DateTime
  sourceId          String?  // referral.source_id = ID do anuncio
  sourceType        String?  // referral.source_type (ad | post)
  ctwaClid          String?  // identificador do clique
  headline          String?
  body              String?
  sourceUrl         String?
  mediaType         String?
  platform          String?  // facebook | instagram (so quando da pra saber pela URL); null = Meta Ads sem plataforma
  wabaId            String?  // WhatsApp Business Account ID (so existe na API oficial)
  rawKeys           String?  // nomes dos campos recebidos (diagnostico; sem valores)
  entryKind         String   @default("first") // first | new_ad | new_click
  createdAt         DateTime @default(now())

  @@unique([clinicId, messageExternalId])
  @@index([patientId, receivedAt])
  @@index([clinicId, sourceId])
}

// Nomes do anuncio/conjunto/campanha, buscados na Marketing API pelo source_id (o webhook NAO entrega esses nomes).
model AdCatalog {
  id           String   @id @default(cuid())
  clinicId     String
  sourceId     String
  adName       String?
  adsetName    String?
  campaignName String?
  status       String   @default("pending") // pending | resolved | unavailable
  attempts     Int      @default(0)
  error        String?
  checkedAt    DateTime?
  createdAt    DateTime @default(now())

  @@unique([clinicId, sourceId])
}

// Historico de classificacoes comerciais do lead (quem, quando, por que). A atual = a ultima confirmada e nao substituida.
model LeadClassification {
  id            String   @id @default(cuid())
  clinicId      String
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status        String   // em_qualificacao | qualificado | desqualificado
  reasonCode    String?  // interesse_real | pediu_agendamento | pediu_orcamento | quer_continuar | sem_interesse | fora_do_perfil | teste_ou_spam | vaga_emprego | outro
  reason        String?  // motivo comercial objetivo (nunca dado de saude)
  source        String   // manual | etapa | ia
  confirmed     Boolean  @default(true) // false = sugestao da IA aguardando revisao humana (nao vira tag nem evento)
  actorName     String?  // quem confirmou/classificou (null = sistema)
  attributionId String?  // entrada de anuncio a que esta classificacao se refere (origem atribuida a conversao)
  metaStatus    String?  // situacao do feedback pra Meta: enfileirado | enviado | somente_crm: ... | nao_elegivel: ...
  metaEventId   String?  // MetaEvent.eventId
  supersededAt  DateTime?
  createdAt     DateTime @default(now())
  decidedAt     DateTime?

  @@index([patientId, createdAt])
  @@index([clinicId, confirmed, createdAt])
}

// Controle PERSISTENTE dos lembretes/confirmacoes automaticas (16/10/2026, Lisboa: confirmacao repetida no mesmo dia e com horario velho).
// Uma linha por (reserva, regra, horario do agendamento): e adquirida de forma ATOMICA (indice unico) ANTES do envio, sobrevive a reinicio e a
// copias do mesmo agendamento (a chave e o uuid da reserva no Clinica Experts, ou o id local quando nao ha CE) e NAO e apagada quando o
// agendamento e remarcado: o historico do horario antigo fica, e o horario novo ganha o proprio controle. Sem relacao com Appointment de proposito
// (e trilha: continua mesmo se o agendamento sumir).
// Confirmacao de agendamento criado FORA da conversa (painel manual / API externa): uma linha por (agendamento, horario). Remarcar gera outro horario = outra linha (o texto antigo
// nunca e reenviado). Estados: reserved (provedor NAO chamado) | sending (pode ter sido chamado) | sent | unconfirmed (incerto: nunca reenvia as cegas) | retry (falha temporaria:
// a recuperacao tenta de novo dentro da janela) | superseded (cancelado/remarcado/passou) | blocked | vetoed | duplicate | failed_permanent. Sem relacao com Appointment de proposito (trilha).
model AppointmentConfirmation {
  id            String    @id @default(cuid())
  clinicId      String
  appointmentId String
  patientId     String
  startsAt      DateTime  // horario a que o texto se refere
  state         String
  attempts      Int       @default(0)
  note          String?
  reservedAt    DateTime?
  attemptedAt   DateTime?
  finalAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([appointmentId, startsAt])
  @@index([state, createdAt])
  @@index([clinicId])
}

model ReminderDispatch {
  id            String   @id @default(cuid())
  clinicId      String
  bookingKey    String   // "ce:<uuid da reserva>" ou "appt:<id local>"
  appointmentId String?
  patientId     String
  ruleId        String
  kind          String   // dia_seguinte | do_dia | cobranca | outro:<ruleId>
  startsAt      DateTime // horario do agendamento a que a mensagem se refere
  sendDay       String   // AAAA-MM-DD (fuso da clinica) do envio
  state         String   // deferred | reserved | sent | unconfirmed | blocked | vetoed | duplicate | failed | failed_permanent | exhausted
  attempt       Int      @default(1)
  detail        String?  // motivo da decisao (sem dados pessoais)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([bookingKey, ruleId, startsAt])
  @@unique([bookingKey, kind, startsAt, sendDay])
  @@index([clinicId, patientId, sendDay])
}

// Controle PERSISTENTE dos recontatos e retomadas (17/10/2026, Lisboa: "os recontatos nao foram feitos" sem nenhum rastro do motivo). Uma linha por
// (pessoa, fluxo, etapa, ciclo), reservada de forma ATOMICA antes de qualquer envio; guarda tambem a decisao (camada, motivo, se pode ser reavaliada).
// Sem relacao de proposito (e trilha de auditoria). Ver src/crm/followupLedger.ts.
model FollowUpDispatch {
  id             String    @id @default(cuid())
  clinicId       String
  patientId      String
  conversationId String?
  flow           String    // recontato | avaliacao_cancelada | avaliacao_sem_fechamento
  ruleId         String?
  step           Int       @default(0) // ordem da regra (recontato) ou 1
  cycleKey       String    // evento de origem: ultima mensagem da pessoa (recontato) ou a reserva (retomada)
  dueAt          DateTime?
  state          String    // deferred | reserved | sent | unconfirmed | blocked | vetoed | duplicate | failed | failed_permanent | expired | skipped
  attempt        Int       @default(1) // quantas vezes a etapa foi reservada (informativo)
  vetoes         Int       @default(0) // vetos (juiz de IA ou revisao de envio): 2 = definitivo
  deferrals      Int       @default(0) // adiamentos por falha tecnica da IA / conferencia inconclusiva
  failures       Int       @default(0) // falhas definitivas de envio (nada saiu)
  layer          String?   // janela | expediente | elegibilidade | concorrencia | juiz_ia | revisao_envio | envio | politica
  reason         String?   // motivo curto, sem conteudo de conversa
  temporary      Boolean   @default(false)
  reevaluateAt   DateTime?
  fingerprint    String?
  runMode        String?   // modo em que a decisao foi tomada: normal | restrito (validacao controlada)
  version        String?
  decidedAt      DateTime  @default(now()) // quando a decisao foi tomada, pelo RELOGIO DA RODADA (nos testes e nas rodadas dirigidas nao e o do banco)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([patientId, flow, step, cycleKey])
  @@index([clinicId, flow, state, decidedAt])
  @@index([patientId, createdAt])
}

// Resumo de cada rodada de um job por clinica (o que viu e o que fez): distingue "o job nao rodou" de "rodou sem candidatas", "todas excluidas",
// "a IA barrou" e "o provedor falhou". So contagens e codigos de motivo. Ver src/crm/automationRuns.ts.
model AutomationRun {
  id         String   @id @default(cuid())
  job        String
  clinicId   String?
  startedAt  DateTime
  finishedAt DateTime
  outcome    String   // ok | erro
  candidates Int      @default(0)
  eligible   Int      @default(0)
  sent       Int      @default(0)
  deferred   Int      @default(0)
  ignored    Int      @default(0)
  vetoed     Int      @default(0)
  failed     Int      @default(0)
  uncertain  Int      @default(0)
  reasons    String?  // JSON { "ignorado:ja_tem_horario": 3, ... }
  mode       String?  // modo de execucao da rodada: normal | restrito (validacao controlada com contatos de teste)
  error      String?
  version    String?

  @@index([job, clinicId, startedAt])
  @@index([startedAt])
}

// Configuracao das RETOMADAS por clinica (avaliacao cancelada / avaliacao realizada sem fechamento). NASCE DESLIGADA e sem texto: so envia depois que a
// clinica liga e aprova o texto. Nada de dia, horario ou publico e presumido aqui. Ver src/crm/resumeFlows.ts.
model ResumeFlowConfig {
  id           String    @id @default(cuid())
  clinicId     String
  flow         String    // avaliacao_cancelada | avaliacao_sem_fechamento
  enabled      Boolean   @default(false)
  weekday      Int?      // 0-6 (0 = domingo): dia em que a retomada sai; null = qualquer dia de atendimento
  startHour    Int?      // janela de envio (hora local da clinica)
  endHour      Int?
  lookbackDays Int       @default(7)  // so considera cancelamentos / avaliacoes dos ultimos N dias (nada de mensagem antiga em massa)
  maxPerRun    Int       @default(10)
  maxPerDay    Int       @default(20)
  message      String?   // texto aprovado pela clinica; sem texto nao envia
  runMode      String    @default("normal") // normal | restrito (validacao controlada: so os contatos de teste abaixo, com limite; qualquer outro valor BLOQUEIA)
  testPatientIds String?  // modo restrito: JSON com os ids dos pacientes DESTA clinica autorizados para o teste (lista vazia/invalida = nada e enviado)
  testMaxSends Int?      // modo restrito: quantos envios o teste pode fazer (obrigatorio)
  testStartedAt DateTime? // modo restrito: desde quando o limite conta
  delayMinutes Int?      // so no fluxo "indicacao": quanto tempo depois do agradecimento (sem isso o convite fica desligado: a clinica ainda nao definiu o intervalo)
  enabledAt    DateTime?
  updatedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([clinicId, flow])
}

// Selecao EXPLICITA da equipe para a retomada de "avaliacao realizada sem fechamento": o sistema nao tem como saber, sozinho, quem avaliou e nao fechou
// (fechamento acontece fora da Alice); so quem a equipe marcar entra, uma a uma. Ver src/crm/resumeFlows.ts.
model ResumeTarget {
  id         String   @id @default(cuid())
  clinicId   String
  patientId  String
  flow       String   // avaliacao_sem_fechamento
  note       String?
  markedBy   String?
  markedAt   DateTime @default(now())
  status     String   @default("pending") // pending | sent | cancelled | ineligible
  resultNote String?
  updatedAt  DateTime @updatedAt

  @@unique([patientId, flow])
  @@index([clinicId, flow, status])
}

// ---------------------------------------------------------------------------
// MEDICAO PERSISTENTE DA OPENAI (src/ai/usageStats.ts). Sem conteudo de conversa, sem credencial, sem dado pessoal: so identificadores, contagens e tempos.
// AiCall = uma linha por TENTATIVA (inclusive as que falharam e as correcoes/reescritas), guardada por pouco tempo; AiUsageDaily = o agregado por dia/clinica/finalidade/modelo,
// onde as linhas antigas de AiCall sao somadas antes de serem apagadas (o banco nao cresce sem limite). Sem chave estrangeira de proposito: apagar clinica nao trava a medicao.
// ---------------------------------------------------------------------------
model AiCall {
  id             String   @id @default(cuid())
  at             DateTime @default(now())
  clinicId       String?
  conversationId String?
  traceId        String?  // agrupa as chamadas de UM atendimento (uma resposta gerada)
  purpose        String   // conversa_alice | segunda_leitura | revisao_envio | memoria_do_lead | resumo_crm | juiz_recontato | reescrita_* | ...
  requestedModel String?
  model          String?  // modelo que a OpenAI informou ter usado (pode ser um snapshot datado)
  inputTokens    Int      @default(0)
  cachedTokens   Int      @default(0) // parte da entrada reaproveitada do cache (ja esta DENTRO de inputTokens)
  outputTokens   Int      @default(0)
  durationMs     Int      @default(0)
  outcome        String   // ok | error | blocked
  usageState     String   @default("known") // known = a API informou o uso | unknown = a requisicao FOI enviada e o consumo nao foi informado (timeout, erro, resposta sem uso) | not_sent = bloqueada localmente, nenhuma requisicao
  errorKind      String?  // quota | auth | rate_limit | unavailable | model | timeout | bad_request | other
  attemptReason  String?  // answer | tool_result | correction:<qual> | retry:<causa> | fallback_model
  attempt        Int      @default(1)

  @@index([at])
  @@index([clinicId, at])
  @@index([traceId])
}

model AiUsageDaily {
  day          String   // AAAA-MM-DD (UTC)
  clinicId     String   @default("") // "" = chamada sem clinica
  purpose      String
  model        String   @default("") // "" = modelo nao informado
  calls        Int      @default(0)
  okCalls      Int      @default(0)
  errorCalls   Int      @default(0)
  unknownCalls Int      @default(0) // tentativas enviadas SEM consumo informado: o total de tokens/custo do dia e um PISO, nao o total
  notSentCalls Int      @default(0) // chamadas bloqueadas localmente (nenhuma requisicao saiu)
  inputTokens  Int      @default(0)
  cachedTokens Int      @default(0)
  outputTokens Int      @default(0)
  durationMs   Int      @default(0)

  @@id([day, clinicId, purpose, model])
}

// Pedido de demonstracao vindo do formulario da landing (public/site). Um registro por telefone (reenvio so atualiza e conta). O IP nao e guardado: so um HMAC curto (limite de abuso).
// Nenhuma mensagem e disparada para o visitante; a equipe comercial ve a lista em GET /api/site-leads (admin).
model SiteLead {
  id              String   @id @default(cuid())
  phoneKey        String   @unique // DDD + numero canonico (nunca duas linhas para o mesmo telefone)
  phone           String   // 55 + DDD + numero
  name            String
  company         String
  segment         String
  volume          String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  gclid           String?
  fbclid          String?
  referrer        String?
  landingPath     String?
  userAgent       String?
  ipHash          String?
  submissions     Int      @default(1)
  status          String   @default("novo") // novo | contatado | descartado (uso interno)
  createdAt       DateTime @default(now())
  lastSubmittedAt DateTime @default(now())

  @@index([createdAt])
  @@index([ipHash, createdAt])
}
