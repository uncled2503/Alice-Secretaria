// SQLite: banco em arquivo, sem custo de hospedagem de DB.
// Quando o volume crescer, troca "provider" para "postgresql" e o schema
// continua funcionando quase sem alteracoes.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Clinic {
  id            String    @id @default(cuid())
  name          String
  whatsappPhone String    @unique // numero do WhatsApp conectado (formato 55DDDNUMERO); atualizado sozinho ao parear
  timezone      String    @default("America/Sao_Paulo")
  workStartHour Int       @default(9)
  workEndHour   Int       @default(19)
  workDays      String    @default("1,2,3,4,5,6") // dias da semana com expediente (0=domingo..6=sabado), separados por virgula
  active        Boolean   @default(true) // false = bloqueada temporariamente (ex: inadimplencia) - contas client dessa clinica nao conseguem logar nem usar a API
  notifyPhone   String?   // numero (com DDI/DDD) que recebe avisos de agendamento/cancelamento/handoff via WhatsApp
  notifyEvents  String    @default("") // quais avisos mandar pro notifyPhone, separados por virgula: new_appointment,reschedule,cancel,human_handoff

  // Credenciais da instancia UAZAPI desta clinica. O token nunca e enviado
  // ao navegador; fica restrito ao backend e aos backups protegidos do banco.
  uazapiBaseUrl String?
  uazapiToken   String?   @unique

  // Como a Alice se apresenta no atendimento ao paciente. Ela NUNCA se
  // identifica como IA/assistente virtual - so como:
  //   team                   -> "da equipe da {clinica}"
  //   clinic_secretary       -> "secretaria da {clinica}"
  //   professional_secretary -> "secretaria de {assistantPersonaName}"
  assistantPersona     String  @default("team")
  assistantPersonaName String? // nome do profissional quando assistantPersona = professional_secretary (ex: "Dra. Camila")

  // Ajustes da Alice (aba "Personalizar Alice" -> "Ajustes")
  assistantName        String  @default("Alice") // nome pelo qual ela se apresenta
  activityArea         String? // area de atuacao da clinica, em texto livre (ajuda a Alice a entender o tipo de cuidado)
  handoffPhrase        String? // frase que ela escreve antes de passar pra equipe (vazio = frase padrao)
  splitLongMessages    Boolean @default(true) // quebra respostas longas em varias bolhas
  splitMaxMessages     Int     @default(4)
  splitThresholdChars  Int     @default(450) // a partir de quantos caracteres ja e "resposta longa"
  requireDepositProof  Boolean @default(false) // so confirma agendamento apos o paciente enviar comprovante do sinal

  // Perfil de atendimento
  servicePosture       String  @default("comercial") // comercial (proativo, empurra agenda) | consultivo (avaliacao primeiro, sem pressao)
  clinicKind           String  @default("estetica")  // estetica | medica | ambas - "medica"/"ambas" ativa as travas de seguranca medica
  evaluationFirst      Boolean @default(false) // nunca exige que o paciente saiba o procedimento; sempre oferece avaliacao
  allowEmojis          Boolean @default(true)
  schedulingLink       String? // link externo de auto-agendamento (fallback quando a clinica prefere que o paciente marque sozinho)

  importStatus    String?   // null | "running" | "completed" - importacao de contatos/historico do WhatsApp
  importStats     String?   // JSON: {found,created,merged,ignored,conversations,partialHistory,contactsInBase}
  importUpdatedAt DateTime?
  createdAt     DateTime  @default(now())

  procedures    Procedure[]
  patients      Patient[]
  appointments  Appointment[]
  followUpRules FollowUpRule[]
  broadcasts    BroadcastCampaign[]
  customRules   CustomRule[]
  funnelStages  FunnelStage[]
  staffUsers    StaffUser[]
  locations     ClinicLocation[]
  products      Product[]
  professionals Professional[]
  reminderRules ReminderRule[]
  postProcedureRules PostProcedureRule[]
  renewalRules  RenewalRule[]
  birthdayRules BirthdayRule[]
  activityLog   ActivityLog[]
  messageTemplates MessageTemplate[]
  faqs          ClinicFaq[]
  playbooks     Playbook[]
  scheduleBlocks ScheduleBlock[]
  waitlist       WaitlistEntry[]
  uazapiWebhookEvents UazapiWebhookEvent[]
}

// Fila duravel dos webhooks da UAZAPI. A rota confirma o recebimento rapido
// e o worker processa depois, com idempotencia e novas tentativas.
model UazapiWebhookEvent {
  id         String   @id @default(cuid())
  clinicId   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  externalId String
  payload    String
  status     String   @default("pending") // pending | processing | done | failed
  attempts   Int      @default(0)
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([clinicId, externalId])
  @@index([status, createdAt])
}

// "Mensagens prontas": textos que a Alice reaproveita no atendimento
// (boas-vindas, confirmacao, orientacoes). Suporta as mesmas variaveis de
// template das mensagens programadas.
model MessageTemplate {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  name      String
  body      String
  mode      String   @default("adapt") // adapt = ajusta o tom | exact = envia exatamente assim
  whenToUse String?  // dica de contexto pra Alice saber quando usar
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// "FAQ da clinica": perguntas operacionais com resposta oficial (acesso,
// estacionamento, documentos, politicas). Agenda/catalogo/preco continuam
// vindo das fontes oficiais, nao daqui.
model ClinicFaq {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  question    String
  answer      String
  alternates  String   @default("") // outras formas de fazer a mesma pergunta, uma por linha
  exactAnswer Boolean  @default(false) // true = responder exatamente o texto cadastrado
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// "Roteiros": sequencias de conversa que a Alice conduz passo a passo em
// situacoes especificas (primeiro atendimento, remarcacao, pos-procedimento).
model Playbook {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  name        String
  scriptType  String   @default("livre") // primeiro_atendimento | agendamento | procedimento | preco | objecoes | remarcacao | pos_procedimento | transferir | livre
  triggerText String?  // quando este roteiro deve ser usado
  goal        String?  // objetivo que a Alice precisa cumprir
  steps       String   @default("") // um passo por linha
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Historico de atividades da clinica: registro simples de mudancas
// importantes (o que aconteceu, em qual area, quem fez e quando). So pra
// leitura no painel - nenhuma logica depende disso.
model ActivityLog {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  type        String   // slug do evento (ex: human_takeover, appointment_booked)
  area        String   // slug da area (ex: atendimento, agenda, automacoes)
  title       String
  description String?
  actorName   String?  // nome do atendente; null = acao automatica do sistema
  createdAt   DateTime @default(now())

  @@index([clinicId, createdAt])
}

// Unidade/endereco fisico da clinica. Uma clinica pode ter varias (rede com
// mais de um endereco); a ordem (order) define qual aparece primeiro/e e
// qual e a "principal" no painel.
model ClinicLocation {
  id                  String   @id @default(cuid())
  clinicId            String
  clinic              Clinic   @relation(fields: [clinicId], references: [id])
  name                String
  googleMapsUrl       String?
  website             String?
  timezone            String   @default("America/Sao_Paulo")
  street              String?
  number              String?
  complement          String?
  neighborhood        String?
  city                String?
  state               String?
  zipCode             String?
  country             String   @default("Brasil")
  arrivalInstructions String?
  active              Boolean  @default(true)
  order               Int      @default(0)
  createdAt           DateTime @default(now())
}

// Conta de login do painel. role="admin" enxerga/opera todas as clinicas
// (equipe da Alice, o SaaS); role="client" fica restrita a UMA clinica so
// (dono da clinica cliente, ex: Isac) - fica travado nela em toda a API,
// nunca ve nem acessa dados de outra clinica.
model StaffUser {
  id           String   @id @default(cuid())
  clinicId     String? // null pra contas admin - nao pertencem a uma clinica so
  clinic       Clinic?  @relation(fields: [clinicId], references: [id])
  name         String
  username     String   @unique
  passwordHash String
  role         String   @default("client") // admin | client
  createdAt    DateTime @default(now())
}

model Procedure {
  id                 String    @id @default(cuid())
  clinicId           String
  clinic             Clinic    @relation(fields: [clinicId], references: [id])
  name               String
  durationMin        Int       @default(60)
  description        String?

  price              Float?    // valor a vista, em reais; null = nao informado
  priceVariable      Boolean   @default(false) // preco depende de avaliacao presencial
  offerInstallments  Boolean   @default(false)
  maxInstallments    Int?      // ex: 10 -> "10x de R$ X" (calculado a partir de price)
  paymentMethods     String    @default("") // dinheiro,pix,credito,debito separados por virgula
  paymentLink        String?

  // Contexto pra Alice entender e apresentar o procedimento sem inventar
  // indicacao/beneficio/prazo que a clinica nao cadastrou.
  goals              String?   // objetivos/queixas atendidas, uma por linha
  benefits           String?   // beneficios que podem ser afirmados, um por linha
  aliases            String?   // outros nomes/formas de pedir, separados por virgula
  resultTimeline     String?   // quando o resultado costuma aparecer

  appointments  Appointment[]
  professionals Professional[] @relation("ProfessionalProcedures")
  waitlist      WaitlistEntry[]
}

// Diretorio simples de profissionais da clinica (nome, foto, bio, quais
// procedimentos cada um faz). Sem agenda/turno proprio ainda - a atribuicao
// a um agendamento e manual (ver Appointment.professionalId).
model Professional {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  name      String
  instagram String?
  bio       String?
  color     String?  // cor de identificacao (ex: na agenda), hex
  photoUrl  String?  // data URI (base64) da foto enviada
  active    Boolean  @default(true)
  // Agenda propria do profissional. null = herda o expediente da clinica.
  workDays      String? // dias de atendimento (0=domingo..6=sabado), separados por virgula
  workStartHour Int?
  workEndHour   Int?
  createdAt DateTime @default(now())

  procedures     Procedure[]   @relation("ProfessionalProcedures")
  appointments   Appointment[]
  scheduleBlocks ScheduleBlock[]
  waitlist       WaitlistEntry[]
}

// Produto fisico vendido pela clinica (ex: home care), separado de procedimentos.
model Product {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  name        String
  price       Float?
  description String?
  photoUrl    String?  // data URI (base64) da foto enviada
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Patient {
  id            String    @id @default(cuid())
  clinicId      String
  clinic        Clinic    @relation(fields: [clinicId], references: [id])
  phone         String    // numero do paciente no WhatsApp
  name          String?
  birthDate     DateTime? // data de nascimento (so dia/mes importa pro aniversario)
  funnelStage   String    @default("novo_lead") // ver src/crm/stages.ts para a lista de etapas
  optedOut      Boolean   @default(false) // paciente pediu pra nao receber mensagens (LGPD) - trava automacoes
  optedOutAt    DateTime?
  createdAt     DateTime  @default(now())

  conversations Conversation[]
  appointments  Appointment[]
  broadcastRecipients BroadcastRecipient[]
  birthdaySent  BirthdaySent[]
  waitlist      WaitlistEntry[]

  @@unique([clinicId, phone])
}

model Conversation {
  id                String    @id @default(cuid())
  patientId         String
  patient           Patient   @relation(fields: [patientId], references: [id])
  status            String    @default("active") // active | qualified | scheduled | closed
  humanTakeover     Boolean   @default(false) // true = Alice para de responder, atendente assumiu
  handoffReason     String?   // motivo curto do ultimo handoff para humano (ex: "pedido de desconto")
  lastFollowUpOrder Int       @default(0) // ultima etapa de recontato ja enviada (0 = nenhuma)
  lastMessageAt     DateTime  @default(now())
  createdAt         DateTime  @default(now())

  messages          Message[]
  followUpSent      FollowUpSent[]
}

// Cascata de recontato: dispara mensagens automaticas quando o paciente fica
// um tempo sem responder. `order` mantem a sequencia da cascata (recontato 1,
// 2, 3...); cada etapa tem seu proprio nome, tempo de silencio e opcoes.
model FollowUpRule {
  id                 String  @id @default(cuid())
  clinicId           String
  clinic             Clinic  @relation(fields: [clinicId], references: [id])
  order              Int     // 1, 2, 3... define a sequencia da cascata
  name               String  @default("")
  afterDays          Int     // (legado) dias de silencio - mantido; o efetivo e afterMinutes
  afterMinutes       Int     @default(0) // silencio total em minutos pra disparar (0 = usa afterDays)
  message            String  // suporta as variaveis de template ({primeiro_nome} etc)
  repeatMode         String  @default("every_silence") // every_silence | once
  skipIfHumanTakeover Boolean @default(false)
  skipIfUpcomingAppt Boolean @default(true)
  sendWindowStart    Int?    // hora local (0-23) de inicio da janela de envio; null = qualquer horario
  sendWindowEnd      Int?
  active             Boolean @default(true)

  sentLogs           FollowUpSent[]

  @@unique([clinicId, order])
}

// So usado quando repeatMode = "once": trava um envio dessa regra por conversa
// pra sempre (no "every_silence" a cascata reinicia a cada novo silencio e essa
// tabela e ignorada).
model FollowUpSent {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  ruleId         String
  rule           FollowUpRule @relation(fields: [ruleId], references: [id])
  sentAt         DateTime     @default(now())

  @@unique([conversationId, ruleId])
}

// Mensagem agendada em massa para a base de contatos (ou um estagio do funil).
// O envio real acontece aos poucos (ver src/crm/broadcast.ts) pra nao estourar
// limite de taxa do WhatsApp e respeitar o horario comercial da clinica.
model BroadcastCampaign {
  id           String   @id @default(cuid())
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id])
  title        String
  message      String   // suporta {nome}/{primeiro_nome}/{nome_completo}/{telefone}/{endereco}/{unidade}/{data_hora}
  targetStage  String?  // usado so quando targetMode = "stage" - id de src/crm/stages.ts
  targetMode   String   @default("all") // all | stage | contacts - contacts usa BroadcastRecipient pre-populado na criacao
  scheduledFor DateTime
  status       String   @default("scheduled") // scheduled | sending | completed | cancelled
  createdAt    DateTime @default(now())

  recipients   BroadcastRecipient[]
}

model BroadcastRecipient {
  id         String            @id @default(cuid())
  campaignId String
  campaign   BroadcastCampaign @relation(fields: [campaignId], references: [id])
  patientId  String
  patient    Patient           @relation(fields: [patientId], references: [id])
  status     String            @default("pending") // pending | sent | failed
  sentAt     DateTime?

  @@unique([campaignId, patientId])
}

// Regra de atendimento gerada a partir de um texto livre do admin ("descreva
// a mudanca"). A IA classifica numa categoria e escreve a instrucao final, ou
// devolve uma pergunta se faltar informacao. So entra no prompt da Alice
// depois que o admin aprova (status=active).
model CustomRule {
  id                 String   @id @default(cuid())
  clinicId           String
  clinic             Clinic   @relation(fields: [clinicId], references: [id])
  category           String   // agendamento | pagamento | tom_de_voz | chamar_equipe | procedimentos
  rawInput           String   // o que o admin digitou originalmente
  instruction        String?  // regra final pronta pra entrar no prompt (null se ainda precisa esclarecer)
  clarifyingQuestion String?  // pergunta da IA quando falta informacao
  status             String   @default("draft") // needs_clarification | draft | active
  createdAt          DateTime @default(now())
}

// Etapas do funil kanban, editaveis por clinica. Quando uma clinica ainda
// nao tem nenhuma, o app cria as 10 padrao automaticamente na primeira
// consulta (ver src/crm/stages.ts). stageId e o slug estavel guardado em
// Patient.funnelStage - editar label/color/kind nao quebra os pacientes ja
// nessa etapa, so renomear/apagar o stageId em si exigiria migrar os dados.
model FunnelStage {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  stageId  String // slug usado em Patient.funnelStage
  label    String
  color    String
  kind     String // aberta | avaliacao_agendada | ganho | pos_procedimento | perdido
  order    Int

  @@unique([clinicId, stageId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String       // user | assistant | human | system (system = evento de transferencia, nao e mensagem de chat)
  content        String
  authorName     String?      // nome do atendente logado que enviou/transferiu (null = Alice, ou ninguem logado)
  createdAt      DateTime     @default(now())
}

model Appointment {
  id             String        @id @default(cuid())
  clinicId       String
  clinic         Clinic        @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id])
  procedureId    String
  procedure      Procedure     @relation(fields: [procedureId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  scheduledAt    DateTime
  status         String        @default("confirmed") // confirmed | cancelled | completed
  patientConfirmed Boolean     @default(false) // paciente confirmou presenca (resposta ao lembrete)
  confirmedAt    DateTime?
  createdAt      DateTime      @default(now())

  reminders      ReminderSent[]
  postProcedureSent PostProcedureSent[]
  renewalSent    RenewalSent[]
}

// Bloqueio de agenda: feriado, almoco, folga, manutencao de equipamento.
// professionalId null = bloqueia a clinica inteira nesse intervalo.
model ScheduleBlock {
  id             String        @id @default(cuid())
  clinicId       String
  clinic         Clinic        @relation(fields: [clinicId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  reason         String        @default("")
  createdAt      DateTime      @default(now())

  @@index([clinicId, startsAt])
}

// Lista de espera: paciente que quis um horario indisponivel. Quando abre uma
// vaga (cancelamento) a Alice avisa o primeiro da fila compativel.
model WaitlistEntry {
  id             String        @id @default(cuid())
  clinicId       String
  clinic         Clinic        @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  procedureId    String?
  procedure      Procedure?    @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  preferredNote  String        @default("") // "quinta de manha" - texto livre do paciente
  status         String        @default("waiting") // waiting | notified | converted | cancelled
  createdAt      DateTime      @default(now())
  notifiedAt     DateTime?

  @@index([clinicId, status])
}

// Lembrete automatico de consulta, configuravel (pode ter mais de um, ex: 24h
// antes e 2h antes). ReminderSent evita mandar o mesmo lembrete duas vezes
// pro mesmo agendamento.
model ReminderRule {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  hoursBefore Int      @default(24)
  message     String   // suporta as mesmas variaveis do broadcast + {procedimento}/{profissional}/{hora}
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  sentLogs    ReminderSent[]
}

model ReminderSent {
  id            String       @id @default(cuid())
  appointmentId String
  appointment   Appointment  @relation(fields: [appointmentId], references: [id])
  ruleId        String
  rule          ReminderRule @relation(fields: [ruleId], references: [id])
  sentAt        DateTime     @default(now())

  @@unique([appointmentId, ruleId])
}

// Mensagem automatica de acompanhamento pos-procedimento (cuidados, checar
// como o paciente esta). Dispara X horas/dias depois do agendamento, so pra
// procedimentos concluidos (se onlyIfCompleted) e so pros procedimentos
// escolhidos (procedureIds vazio = todos).
model PostProcedureRule {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id])
  name            String
  message         String
  intervalValue   Int      @default(1)
  intervalUnit    String   @default("days") // hours | days
  onlyIfCompleted Boolean  @default(true)
  procedureIds    String   @default("") // vazio = todos; senao ids separados por virgula
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  sentLogs        PostProcedureSent[]
}

model PostProcedureSent {
  id            String            @id @default(cuid())
  appointmentId String
  appointment   Appointment       @relation(fields: [appointmentId], references: [id])
  ruleId        String
  rule          PostProcedureRule @relation(fields: [ruleId], references: [id])
  sentAt        DateTime          @default(now())

  @@unique([appointmentId, ruleId])
}

// Renovacao: retoma o contato meses/anos depois do fim do atendimento pra
// renovar um procedimento periodico (botox, preenchimento etc). Mesma
// mecanica do pos-procedimento, so muda a escala de tempo (limite 2 anos).
model RenewalRule {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id])
  name            String
  message         String
  intervalValue   Int      @default(1)
  intervalUnit    String   @default("months") // months | years
  onlyIfCompleted Boolean  @default(true)
  procedureIds    String   @default("") // vazio = todos
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  sentLogs        RenewalSent[]
}

model RenewalSent {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  ruleId        String
  rule          RenewalRule @relation(fields: [ruleId], references: [id])
  sentAt        DateTime    @default(now())

  @@unique([appointmentId, ruleId])
}

// Mensagem automatica de parabens no dia do aniversario do paciente (usa
// Patient.birthDate). BirthdaySent trava um envio por regra/paciente/ano.
model BirthdayRule {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  name      String
  message   String
  sendHour  Int      @default(9) // hora local da clinica pra disparar
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  sentLogs  BirthdaySent[]
}

model BirthdaySent {
  id        String       @id @default(cuid())
  patientId String
  patient   Patient      @relation(fields: [patientId], references: [id])
  ruleId    String
  rule      BirthdayRule @relation(fields: [ruleId], references: [id])
  year      Int
  sentAt    DateTime     @default(now())

  @@unique([patientId, ruleId, year])
}
