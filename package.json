{
  "name": "alice-secretaria-virtual",
  "version": "0.1.0",
  "description": "Secretaria virtual com IA para clinicas de estetica, via WhatsApp (Baileys) + OpenAI",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "prisma migrate deploy && node dist/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "pm2:start": "npm run build && npx pm2 start ecosystem.config.cjs",
    "pm2:stop": "npx pm2 stop alice",
    "pm2:restart": "npm run build && npx pm2 restart ecosystem.config.cjs",
    "pm2:logs": "npx pm2 logs alice",
    "pm2:status": "npx pm2 status",
    "relay-agent": "node scripts/relay-agent.mjs"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@prisma/client": "^5.20.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "openai": "^7.5.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/qrcode": "^1.5.6",
    "pm2": "^7.0.4",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
